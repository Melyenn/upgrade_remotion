# Copy this file to .env and fill in your keys.
# .env is gitignored - never commit real keys.

# Required by scripts/generate-voiceover.mjs (and scripts/create-video.mjs).
# Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional. Only needed if you want scripts/generate-slide-content.mjs (and
# scripts/create-video.mjs) to call the Claude API with a specific key
# instead of using your already-logged-in `claude` CLI session.
ANTHROPIC_API_KEY=
